# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_JWT_SECRET=your-supabase-jwt-secret

# Encryption key for provider API keys stored in DB
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
PROVIDER_ENCRYPTION_KEY=your-fernet-key-here

# Polar payment integration — all Polar config lives here, never in the frontend
POLAR_ACCESS_TOKEN=your-polar-org-access-token
POLAR_WEBHOOK_SECRET=your-polar-webhook-signing-secret
# Set to true while using Polar sandbox (sandbox-api.polar.sh); false / omit for production
POLAR_SANDBOX=false
# Product IDs from Polar Dashboard → Products (copy the product ID, not the price ID)
POLAR_PRODUCT_10=polar_product_id_for_10usd
POLAR_PRODUCT_30=polar_product_id_for_30usd
POLAR_PRODUCT_50=polar_product_id_for_50usd
POLAR_PRODUCT_CUSTOM=polar_product_id_for_custom_amount

# CardTransaction payment integration
SCT_API_URL=https://secure.cardtransaction.com
SCT_PROJECT_CODE=proj-xxxxxxxx
SCT_MERCHANT_CODE=mrcnt-xxxxxxxx
SCT_API_KEY=your-cardtransaction-api-key
# Test mode token from CardTransaction dashboard
SCT_TEST_MODE_KEY=your-cardtransaction-test-mode-token
# Plan codes from CardTransaction dashboard (one-time plans, USD)
SCT_PLAN_10=plan-xxxxxxxxxxx
SCT_PLAN_25=plan-xxxxxxxxxxx
SCT_PLAN_50=plan-xxxxxxxxxxx
SCT_PLAN_100=plan-xxxxxxxxxxx
SCT_PLAN_150=plan-xxxxxxxxxxx
SCT_PLAN_200=plan-xxxxxxxxxxx
SCT_PLAN_300=plan-xxxxxxxxxxx

# Internal secret your frontend sends as the x-mode header to trigger CardTransaction test mode
# (if omitted, backend also accepts SCT_TEST_MODE_KEY for compatibility)
TEST_MODE_KEY=your-internal-test-mode-secret

# Public backend URL — used as CardTransaction's callback redirect target
# Local dev: http://localhost:8000  (or your ngrok URL if testing the full callback flow)
# Production: https://your-backend-domain
BACKEND_URL=http://localhost:8000

# Frontend URL (for CORS, also used as the post-payment redirect target)
FRONTEND_URL=http://localhost:5173

# App settings
APP_ENV=development
APP_DEBUG=true
APP_PORT=8000
